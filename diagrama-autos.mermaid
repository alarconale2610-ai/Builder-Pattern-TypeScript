classDiagram
    direction TB

    %% ── CLIENTE (código de uso en la parte superior) ──
    class Cliente {
        director = new DirectorDeVehiculos()
        cocheBuilder = new CocheBuilder()
        manualBuilder = new ManualBuilder()
        director.construirCocheSuperDeportivo(cocheBuilder)
        director.construirCocheSuperDeportivo(manualBuilder)
        coche = cocheBuilder.obtenerCoche()
        manual = manualBuilder.obtenerManual()
    }

    %% ── DIRECTOR ──
    class DirectorDeVehiculos {
        ...
        +construirCocheSuperDeportivo(builder) void
        +construirCocheFamiliar(builder) void
    }

   
    %% ── INTERFAZ BUILDER ──
    class VehiculoBuilder {
        <<interface>>
        +setMotor(tipo) this
        +setAsientos(cantidad) this
        +setGps() this
        +setComputadoraDeBordo() this
    }

    %% ── BUILDER CONCRETO A ──
    class CocheBuilder {
        -coche: Coche
        +setMotor(tipo) this
        +setAsientos(cantidad) this
        +setGps() this
        +setComputadoraDeBordo() this
        +obtenerCoche() Coche
    }

    
    %% ── BUILDER CONCRETO B ──
    class ManualBuilder {
        -manual: ManualDeCoche
        +setMotor(tipo) this
        +setAsientos(cantidad) this
        +setGps() this
        +setComputadoraDeBordo() this
        +obtenerManual() ManualDeCoche
    }

   
    %% ── PRODUCTOS ──
    class Coche {
        +motor: string
        +asientos: number
        +gps: boolean
        +computadoraDeBordo: boolean
        +describir() void
    }

    class ManualDeCoche {
        +descripcionMotor: string
        +descripcionAsientos: string
        +instruccionesGps: string
        +instruccionesComputadora: string
        +describir() void
    }

    %% ── RELACIONES ──
    Cliente ..> DirectorDeVehiculos : usa
    Cliente ..> VehiculoBuilder : usa
    DirectorDeVehiculos ..> VehiculoBuilder : usa por parámetro
    VehiculoBuilder <|.. CocheBuilder : implements
    VehiculoBuilder <|.. ManualBuilder : implements
    CocheBuilder *-- Coche : crea
    ManualBuilder *-- ManualDeCoche : crea